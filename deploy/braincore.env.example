# Braincore Pro — environment (Hetzner). Copy to /etc/braincore/braincore.env and fill in.
# NEVER commit this file. Values are read by systemd (EnvironmentFile) — keys are never echoed by the API.

# ── Required ────────────────────────────────────────────────────────────────
# 32-byte hex secret. Signs every gossip frame (HMAC) and derives the AES-256-GCM payload key.
# Generate: openssl rand -hex 32
NMQ_CLUSTER_SECRET=

# Tenant that owns the swarm on this machine.
NMQ_DEFAULT_TENANT=nmq

# Where tenant data, audit chain and issued API keys live.
NMQ_DATA_DIR=/opt/braincore/data

# ── Optional: shared queue over Redis (RESP client, zero npm) ───────────────
# Leave empty to use the in-memory + file store (fine for a single machine).
NMQ_REDIS_URL=redis://127.0.0.1:6379

# ── Optional: billing (Stripe) ──────────────────────────────────────────────
# Webhook signing secret from the Stripe dashboard (endpoint: https://api.braincore.pro/v1/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Publishable key / price id are used by the checkout link on the static site, not by this service.
STRIPE_PRICE_ID=

# ── Optional: admin access ──────────────────────────────────────────────────
# Required to read /v1/keys and to revoke a key. Generate: openssl rand -hex 24
BRAINCORE_ADMIN_KEY=

# ── Logging ─────────────────────────────────────────────────────────────────
NMQ_LOG_LEVEL=info

# ── Per-node overrides (see /etc/braincore/node-<port>.env) ─────────────────
# Each node has its own file with PORT, API_PORT (only node 1) and PEERS.
