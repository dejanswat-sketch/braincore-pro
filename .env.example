# NMQ Robot — primjer env fajla. NIKAD ne commit-ovati .env
# Ključeve čitaj iz DSH store-a: node C:\Users\Administrator\.dsh\NMQ\get-key.mjs <IME_KLJUCA>

# --- server ---
NMQ_PORT=8787
NMQ_HOST=127.0.0.1
NMQ_PUBLIC_URL=http://127.0.0.1:8787
NMQ_DATA_DIR=./data
NMQ_LOG_LEVEL=info
NMQ_DEFAULT_TENANT=nmq

# --- LLM (OpenAI-kompatibilno) ---
# provider: openai-compatible | mock
NMQ_LLM_PROVIDER=openai-compatible
NMQ_LLM_BASE_URL=https://api.deepseek.com/v1
NMQ_LLM_MODEL=deepseek-chat
NMQ_LLM_API_KEY=            # DEEPSEEK_API_KEY
NMQ_LLM_FAST_MODEL=deepseek-chat
NMQ_LLM_EMBED_MODEL=        # npr. text-embedding-3-small (opciono; bez njega radi hash-embedder)
NMQ_LLM_TIMEOUT_MS=60000
NMQ_LLM_MAX_RETRIES=2

# --- fallback lanac (opciono) ---
# NMQ_LLM_FALLBACKS=[{"baseUrl":"https://api.openai.com/v1","model":"gpt-4o-mini","apiKeyEnv":"OPENAI_API_KEY"}]

# --- budžeti / limiti (default za sve tenantе ako tenant nema svoje) ---
NMQ_BUDGET_MONTHLY_USD=50
NMQ_BUDGET_RUN_USD=0.50
NMQ_MAX_STEPS=12
NMQ_RATE_LIMIT_PER_MIN=60

# --- bezbjednost ---
# 32-bajtni ključ (hex) za AES-256-GCM enkripciju tenantskih tajni u data/tenants/<id>/secrets.enc
NMQ_MASTER_KEY=
# pepper za hash API ključeva (tenant i per-agent); promjena poništava sve ključeve
NMQ_API_KEY_PEPPER=
# dozvoljeni domeni za http_fetch alat (zarezom razdvojeno; * = sve)
NMQ_HTTP_ALLOWLIST=api.deepseek.com,api.openai.com
# okruženje (ide u OTel resource i logove)
NMQ_ENV=production

# --- persistentni agenti (scheduler) ---
NMQ_SCHEDULER=1
NMQ_SCHEDULER_TICK_MS=1000

# --- OpenTelemetry izvoz ---
# fajl: data/_global/otel-traces.jsonl (OTLP/JSON, jedna linija = jedan run)
NMQ_OTEL_FILE=1
# OTLP HTTP endpoint kolektora (npr. http://otel-collector:4318) — ako je prazan, samo fajl
OTEL_EXPORTER_OTLP_ENDPOINT=
NMQ_OTEL_HEADERS={}

# --- integracije (imena ključeva; vrijednosti drži u DSH store-u ili env-u) ---
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS=
# SLACK_BOT_TOKEN= NOTION_TOKEN= GITHUB_TOKEN= HUBSPOT_TOKEN= STRIPE_SECRET_KEY= SHOPIFY_TOKEN=

# ── Cross-node klaster (v0.5) ─────────────────────────────────────────────
# Bez NMQ_CLUSTER_SECRET klaster se NE pokreće (fail-closed). Tajna se ne upisuje u config.
NMQ_CLUSTER=0                 # 1 = uključi cross-node swarm (gossip + deljena tabla)
NMQ_CLUSTER_PORT=0            # 0 = efemerni port (preporučeno u testu); produkcija: fiksni port
NMQ_CLUSTER_SECRET=          # HMAC tajna za potpisivanje gossip poruka (obavezno ako je NMQ_CLUSTER=1)
NMQ_REDIS_URL=                # npr. redis://127.0.0.1:6379 — bez ovoga se koristi file store (deljeni direktorijum)

